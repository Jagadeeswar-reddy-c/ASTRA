# Template for deploy/compose/.env (see docs/06-deployment/deployment-guide.md §5).
# Keep the "site settings" section in deploy/compose/.env.site; generate the split with
#   astra plan --gguf /srv/models/<model>.gguf --env-file deploy/compose/.env.plan
# and combine:  cat .env.plan .env.site > .env

# ---- written by `astra plan --env-file` ----
ASTRA_ENGINE=llamacpp
ASTRA_GPU_UUIDS=GPU-xxxxxxxx-2060,GPU-xxxxxxxx-3050
ASTRA_LAYER_SPLIT=21,27
ASTRA_PIPELINE_STAGES=2
ASTRA_N_GPU_LAYERS=49
ASTRA_CONTEXT=8192
ASTRA_GPU_UTIL=0.90
ASTRA_MODEL=Qwen2.5-14B-Instruct-Q4_K_M.gguf

# ---- site settings ----
ASTRA_MODEL_DIR=/srv/models
ASTRA_CONFIG_FILE=/etc/astra/astra.toml
ASTRA_BIND=127.0.0.1           # expose inference on the LAN only behind a reverse proxy
GRAFANA_ADMIN_PASSWORD=change-me
HF_TOKEN=
# partitioned profile only
ASTRA_GPU_INFER=GPU-xxxxxxxx-3050
ASTRA_GPU_TRANSCODE=GPU-xxxxxxxx-2060
